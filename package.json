{
  "name": "dom-cash",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "nuxt build && nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "typecheck:tests": "tsc --noEmit -p tests/unit/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "tsx --tsconfig tests/unit/tsconfig.json --test tests/unit/*.test.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:tests && pnpm run test:unit",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:test": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env=\"production\"",
    "db:reset": "rm -rf .wrangler/state/v3/d1/miniflare-D1DatabaseObject && pnpm run db:migrate",
    "db:backup:prod": "tsx scripts/backup-database.ts",
    "deploy:test": "pnpm run check && pnpm run build && wrangler deploy --assets .output/public --env=\"\"",
    "deploy:prod": "pnpm run check && pnpm run build && wrangler deploy --assets .output/public --env=\"production\"",
    "deploy:all": "pnpm run check && pnpm run build && wrangler deploy --assets .output/public --env=\"\" && wrangler deploy --assets .output/public --env=\"production\"",
    "release:test": "pnpm run check && pnpm run build && pnpm run db:migrate:test && wrangler deploy --assets .output/public --env=\"\"",
    "release:prod": "pnpm run check && pnpm run build && pnpm run db:backup:prod && pnpm run db:migrate:prod && wrangler deploy --assets .output/public --env=\"production\"",
    "prepare": "husky",
    "preview:e2e": "nuxt dev --port 8787 --dotenv .env.e2e",
    "build:e2e": "nuxt build --envName e2e",
    "test:e2e": "pnpm run build:e2e && playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:e2e:ui": "playwright test --config playwright.dev.config.ts --ui",
    "test:e2e:browser": "playwright test --config playwright.dev.config.ts --headed --reporter=html",
    "test:e2e:headed": "playwright test --config playwright.dev.config.ts --headed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/i18n": "^10.6.0",
    "daisyui": "^5.7.46",
    "drizzle-orm": "^0.45.3",
    "echarts": "^5.6.0",
    "nuxt": "^4.5.2",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.6.4",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/eslint": "^1.17.0",
    "@pinia/nuxt": "^0.11.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.5",
    "h3": "^1.15.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.142.0"
  },
  "lint-staged": {
    "*.{ts,vue,js}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
